<?xml version="1.0"?>
<pfsense>
	<version>23.0</version>
	<lastchange></lastchange>
	<theme>pfsense</theme>
	<sysctl>
		<item>
			<descr><![CDATA[Disable the pf ftp proxy]]></descr>
			<tunable>debug.pftpx</tunable>
			<value>default</value>
		</item>
	</sysctl>
	<system>
		<optimization>normal</optimization>
		<hostname>pfsense-nhom05</hostname>
		<domain>ptit.edu.vn</domain>
		<dnsallowoverride/>
		<group>
			<name>admins</name>
			<description><![CDATA[System Administrators]]></description>
			<scope>system</scope>
			<gid>1999</gid>
			<member>0</member>
			<priv>page-all</priv>
		</group>
		<user>
			<name>admin</name>
			<descr><![CDATA[Administrator]]></descr>
			<scope>system</scope>
			<groupname>admins</groupname>
			<password>$2y$10$abcdefghijklmnopqrstuvwxyz1234567890</password>
			<uid>0</uid>
			<priv>user-shell-access</priv>
		</user>
		<webgui>
			<protocol>https</protocol>
			<port>443</port>
			<max_procs>2</max_procs>
		</webgui>
		<disablenatreflection>yes</disablenatreflection>
		<ssh>
			<enable>enabled</enable>
			<port>22</port>
		</ssh>
	</system>
	<interfaces>
		<wan>
			<enable/>
			<if>em0</if>
			<descr><![CDATA[WAN_EXTERNAL]]></descr>
			<ipaddr>10.10.10.128</ipaddr>
			<subnet>24</subnet>
			<blockpriv>0</blockpriv>
			<blockbogons>0</blockbogons>
		</wan>
		<lan>
			<enable/>
			<if>em1</if>
			<descr><![CDATA[LAN_INTERNAL]]></descr>
			<ipaddr>10.10.20.1</ipaddr>
			<subnet>24</subnet>
		</lan>
	</interfaces>
	<nat>
		<rule>
			<source>
				<any/>
			</source>
			<destination>
				<network>wanip</network>
				<port>8080</port>
			</destination>
			<protocol>tcp</protocol>
			<target>10.10.20.20</target>
			<local-port>8080</local-port>
			<interface>wan</interface>
			<descr><![CDATA[NAT Port Forward CrushFTP Web Interface]]></descr>
			<associated-rule-id>pass</associated-rule-id>
		</rule>
		<rule>
			<source>
				<any/>
			</source>
			<destination>
				<network>wanip</network>
				<port>21</port>
			</destination>
			<protocol>tcp</protocol>
			<target>10.10.20.20</target>
			<local-port>21</local-port>
			<interface>wan</interface>
			<descr><![CDATA[NAT Port Forward FTPS Command Port]]></descr>
			<associated-rule-id>pass</associated-rule-id>
		</rule>
		<rule>
			<source>
				<any/>
			</source>
			<destination>
				<network>wanip</network>
				<port>22</port>
			</destination>
			<protocol>tcp</protocol>
			<target>10.10.20.20</target>
			<local-port>22</local-port>
			<interface>wan</interface>
			<descr><![CDATA[NAT Port Forward SFTP / SSH Port]]></descr>
			<associated-rule-id>pass</associated-rule-id>
		</rule>
		<outbound>
			<mode>automatic</mode>
		</outbound>
	</nat>
	<filter>
		<!-- Rules cho WAN Interface -->
		<rule>
			<id/>
			<tracker>1000000001</tracker>
			<type>pass</type>
			<interface>wan</interface>
			<ipprotocol>inet</ipprotocol>
			<protocol>tcp</protocol>
			<source>
				<any/>
			</source>
			<destination>
				<address>10.10.20.20</address>
				<port>8080</port>
			</destination>
			<descr><![CDATA[Cho phep truy cap Web CrushFTP tu WAN]]></descr>
		</rule>
		<rule>
			<id/>
			<tracker>1000000002</tracker>
			<type>pass</type>
			<interface>wan</interface>
			<ipprotocol>inet</ipprotocol>
			<protocol>tcp</protocol>
			<source>
				<any/>
			</source>
			<destination>
				<address>10.10.20.20</address>
				<port>21</port>
			</destination>
			<descr><![CDATA[Cho phep truy cap FTPS tu WAN]]></descr>
		</rule>
		<rule>
			<id/>
			<tracker>1000000003</tracker>
			<type>pass</type>
			<interface>wan</interface>
			<ipprotocol>inet</ipprotocol>
			<protocol>tcp</protocol>
			<source>
				<any/>
			</source>
			<destination>
				<address>10.10.20.20</address>
				<port>22</port>
			</destination>
			<descr><![CDATA[Cho phep truy cap SFTP tu WAN]]></descr>
		</rule>
		<rule>
			<id/>
			<tracker>1000000004</tracker>
			<type>pass</type>
			<interface>wan</interface>
			<ipprotocol>inet</ipprotocol>
			<protocol>icmp</protocol>
			<source>
				<any/>
			</source>
			<destination>
				<any/>
			</destination>
			<descr><![CDATA[Cho phep Ping kiem tra ket noi qua WAN]]></descr>
		</rule>
		<!-- Rule chan tat ca cac truy cap khac tu WAN vao LAN (Mac dinh Drop) -->
		<rule>
			<id/>
			<tracker>1000000005</tracker>
			<type>block</type>
			<interface>wan</interface>
			<ipprotocol>inet</ipprotocol>
			<source>
				<any/>
			</source>
			<destination>
				<network>lan</network>
			</destination>
			<descr><![CDATA[Co lap mang LAN, chan sniffing va truy cap trai phep]]></descr>
		</rule>
		<!-- Rules cho LAN Interface -->
		<rule>
			<id/>
			<tracker>1000000006</tracker>
			<type>pass</type>
			<interface>lan</interface>
			<ipprotocol>inet</ipprotocol>
			<source>
				<network>lan</network>
			</source>
			<destination>
				<any/>
			</destination>
			<descr><![CDATA[Default allow LAN to any rule]]></descr>
		</rule>
	</filter>
</pfsense>
